{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "body",
    "author",
    "revision"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
