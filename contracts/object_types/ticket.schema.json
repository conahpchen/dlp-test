{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "status",
    "reporter",
    "application"
  ],
  "properties": {
    "status": {
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    }
  }
}
