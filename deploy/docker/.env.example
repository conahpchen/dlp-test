# Set three independent secrets before starting. Generate each with a password manager.
HONEYNET_DASHBOARD_PASSWORD=
HONEYNET_CONTROL_TOKEN=
HONEYNET_MYSQL_PASSWORD=

# Public decoy ports default to loopback. Dashboard always uses loopback.
HONEYNET_PUBLIC_BIND=127.0.0.1
HONEYNET_WEB_PORT=8080
HONEYNET_COWRIE_PORT=2222
HONEYNET_MYSQL_PORT=3307
HONEYNET_DASHBOARD_PORT=8082

# Enable together after verifying HTTPS connectivity to the real model provider.
RESEARCH_AUTOMATIC_DECOYS=0
# Optional. Enables automatic use of the simulated MySQL catalog.
# RESEARCH_AUTO_SERVICE_CAPABILITIES=mysql_catalog
RESEARCH_MODEL_BASE_URL=https://api.deepseek.com
RESEARCH_MODEL=
RESEARCH_MODEL_API_KEY=
RESEARCH_MODEL_TIMEOUT_SECONDS=15
HONEYNET_SITUATION_MODEL=0

# Optional model-provider controls. Configure these on the control host only.
# RESEARCH_MODEL_TOTAL_TIMEOUT_SECONDS=120
# RESEARCH_MODEL_DRAFT_MAX_TOKENS=3500
# RESEARCH_MODEL_REVIEW_MAX_TOKENS=800
# RESEARCH_MODEL_STREAM=0
# RESEARCH_MODEL_STREAM_USAGE=1
# RESEARCH_MODEL_THINKING=auto
# RESEARCH_MODEL_THINKING_FIELD=thinking
# RESEARCH_MODEL_DAILY_TOKENS=1000000
